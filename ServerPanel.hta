<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta charset="UTF-8">
    <title>برنامه اجرای سرور حسابداری</title>
    <!-- تنظیمات مربوط به اجرای HTA در ویندوز -->
    <HTA:APPLICATION
        ID="AccountingServerApp"
        APPLICATIONNAME="AccountingServer"
        SCROLL="no"
        SINGLEINSTANCE="yes"
        WINDOWSTATE="normal"
        BORDER="dialog"
        MAXIMIZEBUTTON="yes"
        MINIMIZEBUTTON="yes"
        SYSMENU="yes"
        ICON="shell32.dll,22"
    >
    <style>
        /* Reset & Base */
        body, html {
            margin: 0; padding: 0; height: 100%; overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
            background: #0f172a; color: #f1f5f9;
        }
        * { box-sizing: border-box; }
        
        /* Layout */
        .sidebar {
            position: absolute; right: 0; top: 0; bottom: 0; width: 300px;
            background: #1e293b; padding: 25px 20px;
            border-left: 1px solid #334155; z-index: 10;
        }
        .main {
            position: absolute; left: 0; right: 300px; top: 0; bottom: 0;
            background: #0f172a;
        }
        .header {
            position: absolute; top: 0; left: 0; right: 0; height: 85px;
            padding: 0 30px; background: #1e293b; border-bottom: 1px solid #334155;
            display: flex; justify-content: space-between; align-items: center; z-index: 5;
        }
        .header-titles h2 { margin: 0; font-size: 20px; font-weight: bold; color: #f8fafc; }
        .header-titles p { margin: 6px 0 0 0; font-size: 13px; color: #94a3b8; }
        
        /* Terminal */
        .terminal-container {
            position: absolute; top: 85px; bottom: 0; left: 0; right: 0; padding: 25px 30px;
        }
        .terminal-header {
            height: 30px; display: flex; justify-content: space-between; align-items: center;
            color: #94a3b8; font-size: 14px; font-weight: bold;
        }
        .terminal {
            position: absolute; top: 60px; bottom: 30px; left: 30px; right: 30px;
            background: #020617; color: #34d399;
            font-family: Consolas, 'Courier New', monospace; font-size: 14px;
            padding: 20px; border-radius: 10px; border: 1px solid #334155;
            overflow-y: auto; white-space: pre-wrap; direction: ltr; text-align: left;
            line-height: 1.6; box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
        }
        
        /* Components */
        .status-badge {
            display: inline-flex; align-items: center; padding: 8px 16px;
            border-radius: 30px; font-size: 13px; font-weight: bold;
            background: #334155; color: #94a3b8; transition: all 0.3s;
        }
        .status-badge.online {
            background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);
        }
        .status-badge.offline {
            background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);
        }
        .status-dot {
            width: 10px; height: 10px; border-radius: 50%; margin-left: 10px; background: currentColor; box-shadow: 0 0 6px currentColor;
        }
        
        .btn {
            display: block; width: 100%; text-align: right; padding: 12px 18px; margin-bottom: 10px;
            color: #f1f5f9; border-radius: 10px; cursor: pointer; border: 1px solid transparent;
            font-size: 14px; font-weight: bold; font-family: inherit;
            transition: all 0.2s; background: #334155;
        }
        .btn:hover { background: #475569; border-color: #64748b; }
        .btn-primary { background: #0ea5e9; color: white; }
        .btn-primary:hover { background: #0284c7; }
        .btn-start { background: #10b981; color: white; }
        .btn-start:hover { background: #059669; }
        .btn-stop { background: #ef4444; color: white; }
        .btn-stop:hover { background: #dc2626; }
        
        .btn-icon { display: inline-block; width: 28px; text-align: center; margin-left: 8px; font-size: 18px; vertical-align: middle; }
        .clear-btn {
            background: transparent; border: 1px solid #475569; color: #94a3b8;
            padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12px; transition: all 0.2s;
        }
        .clear-btn:hover { background: #334155; color: #fff; }
        .divider { height: 1px; background: #334155; margin: 15px 0; }

        /* Inputs */
        .config-box {
            background: #0f172a; padding: 15px; border-radius: 10px; margin-bottom: 15px; border: 1px solid #334155;
        }
        .config-box label { display: block; font-size: 12px; color: #94a3b8; margin-bottom: 6px; }
        .config-box input[type="text"], .config-box select {
            width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid #475569;
            background: #1e293b; color: white; font-family: Tahoma, sans-serif; font-size: 13px; text-align: left; direction: ltr; margin-bottom: 10px;
        }
        .config-box select { text-align: right; direction: rtl; }
        .config-box input:focus { outline: none; border-color: #0ea5e9; }
    </style>
    <script>
        window.resizeTo(1050, 750);
        
        var shell = new ActiveXObject("WScript.Shell");
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var logFile = "";
        var lastLogSize = 0;
        var isServerOnline = false;
        var currentPort = "3000";

        function getTimeStamp() {
            var d = new Date();
            var h = d.getHours(), m = d.getMinutes(), s = d.getSeconds();
            return "[" + (h<10?"0":"")+h + ":" + (m<10?"0":"")+m + ":" + (s<10?"0":"")+s + "] ";
        }

        function init() {
            var htaPath = unescape(document.location.pathname);
            if (htaPath.charAt(0) == '/' && htaPath.charAt(2) == ':') {
                htaPath = htaPath.substring(1);
            }
            var projectDir = fso.GetParentFolderName(htaPath);
            shell.CurrentDirectory = projectDir;
            
            logFile = projectDir + "\\server_logs.txt";
            
            try {
                var f = fso.CreateTextFile(logFile, true);
                f.Close();
            } catch(e) {}
            
            setInterval(readLogs, 1000);
            setInterval(checkServerStatus, 2500); // Check status every 2.5 seconds
            
            checkServerStatus();
            logMsg("✅ سیستم مدیریت حسابداری آماده است.");
            logMsg("مسیر پروژه: " + projectDir);
            logMsg("جهت شروع، روی دکمه «راه‌اندازی سرور» کلیک کنید...\n");
        }

        function stripAnsi(str) {
            return str.replace(/\x1B\[[0-9;]*[a-zA-Z]/g, "");
        }

        function runCmdHidden(cmd) {
            try {
                var f = fso.CreateTextFile(logFile, true);
                f.Close();
                lastLogSize = 0;
                document.getElementById('terminal').innerHTML = '';
                
                shell.Run("cmd.exe /c \"chcp 65001 >nul & " + cmd + " > \"" + logFile + "\" 2>&1\"", 0, false);
            } catch(e) {
                logMsg("خطا: " + e.message);
            }
        }

        function logMsg(msg) {
            var term = document.getElementById('terminal');
            term.innerHTML += getTimeStamp() + msg + "\n";
            term.scrollTop = term.scrollHeight;
        }

        function readLogs() {
            try {
                if (fso.FileExists(logFile)) {
                    var file = fso.GetFile(logFile);
                    if (file.Size > lastLogSize) {
                        var ts = fso.OpenTextFile(logFile, 1, false);
                        var content = ts.ReadAll();
                        ts.Close();
                        
                        var newContent = content.substring(lastLogSize);
                        if (newContent.length > 0) {
                            newContent = newContent.replace(/</g, "&lt;").replace(/>/g, "&gt;");
                            newContent = stripAnsi(newContent);
                            
                            var term = document.getElementById('terminal');
                            term.innerHTML += newContent;
                            term.scrollTop = term.scrollHeight;
                            
                            lastLogSize = content.length;
                        }
                    }
                }
            } catch(e) {}
        }

        function updateStatusBadge(isOnline) {
            isServerOnline = isOnline;
            var badge = document.getElementById('status-badge');
            if (isOnline) {
                badge.className = "status-badge online";
                badge.innerHTML = "<span class='status-dot'></span> فعال در پورت " + currentPort;
            } else {
                badge.className = "status-badge offline";
                badge.innerHTML = "<span class='status-dot'></span> سرور خاموش است";
            }
        }

        function checkServerStatus() {
            try {
                var port = document.getElementById('portNum').value || "3000";
                var xhr = new ActiveXObject("Microsoft.XMLHTTP");
                // استفاده از true به معنای اجرای غیرهمزمان (Asynchronous) است تا صفحه قفل نشود
                xhr.open("GET", "http://127.0.0.1:" + port + "/?t=" + new Date().getTime(), true); 
                
                xhr.onreadystatechange = function() {
                    if (xhr.readyState === 4) {
                        // اگر status بزرگتر از صفر باشد یعنی سرور پاسخی داده است (روشن است)
                        updateStatusBadge(xhr.status > 0);
                    }
                };
                
                // هندل کردن ارورهای شبکه بدون متوقف کردن کد
                xhr.onerror = function() {
                    updateStatusBadge(false);
                };
                
                xhr.send();
            } catch(e) {
                updateStatusBadge(false);
            }
        }

        function startServer() {
            var port = document.getElementById('portNum').value || "3000";
            var hostOption = document.getElementById('hostSelect').value;
            currentPort = port;
            
            var cmd = "npm run dev -- --port " + port;
            if (hostOption === "network") {
                cmd += " --host";
                logMsg("در حال راه‌اندازی سرور تحت شبکه (دسترسی برای همه سیستم‌ها)...");
            } else {
                logMsg("در حال راه‌اندازی سرور محلی (Localhost) ...");
            }
            
            logMsg("پورت تنظیمی: " + port);
            logMsg("دستور اجرایی: " + cmd);
            runCmdHidden(cmd);
        }

        function stopServer() {
            var port = document.getElementById('portNum').value || "3000";
            logMsg("در حال توقف سرویس‌های روی پورت " + port + "...");
            try {
                var tempBat = shell.ExpandEnvironmentStrings("%TEMP%") + "\\kill_server.bat";
                var f = fso.CreateTextFile(tempBat, true);
                f.WriteLine("@echo off");
                f.WriteLine("FOR /F \"tokens=5\" %%a in ('netstat -a -n -o ^| findstr :" + port + "') do taskkill /f /pid %%a");
                f.Close();
                
                shell.Run("cmd.exe /c \"" + tempBat + "\"", 0, true);
                logMsg("سیگنال توقف با موفقیت ارسال شد.");
                setTimeout(checkServerStatus, 1000);
            } catch(e) {
                logMsg("خطا در توقف سرور: " + e.message);
            }
        }

        function restartServer() {
            stopServer();
            logMsg("صبر کنید...");
            setTimeout(startServer, 2000);
        }

        function gitPull() {
            logMsg("دریافت آخرین تغییرات و بروزرسانی نرم‌افزار...");
            runCmdHidden("git pull");
        }
        
        function npmInstall() {
            logMsg("بررسی و نصب کتابخانه‌های جدید (ممکن است زمان‌بر باشد)...");
            runCmdHidden("npm install");
        }

        function openBrowser() {
            var port = document.getElementById('portNum').value || "3000";
            if (isServerOnline) {
                shell.Run("http://localhost:" + port);
                logMsg("برنامه در مرورگر باز شد.");
            } else {
                alert("لطفاً ابتدا سرور را راه‌اندازی کنید (وقتی چراغ وضعیت سبز شد روی این گزینه کلیک کنید).");
            }
        }

        function openFolder() {
            shell.Run("explorer.exe .");
            logMsg("پوشه نرم‌افزار باز شد.");
        }

        function clearTerminal() {
            document.getElementById('terminal').innerHTML = '';
            lastLogSize = 0;
            try {
                var f = fso.CreateTextFile(logFile, true);
                f.Close();
            } catch(e){}
            logMsg("ترمینال پاک شد.");
        }
    </script>
</head>
<body onload="init()">
    <div class="sidebar">
        <div style="margin-bottom: 20px; text-align: center;">
            <div style="font-size: 45px; margin-bottom: 10px;">📊</div>
            <h2 style="margin: 0; font-size: 20px; color: #f8fafc;">نرم‌افزار حسابداری</h2>
        </div>

        <div class="config-box">
            <label>شماره پورت اجرا (پیش‌فرض 3000)</label>
            <input type="text" id="portNum" value="3000" maxlength="5">
            
            <label>نحوه دسترسی (شبکه)</label>
            <select id="hostSelect">
                <option value="local">فقط روی همین سیستم (Localhost)</option>
                <option value="network" selected>قابل دسترس در کل شبکه (Host)</option>
            </select>
        </div>

        <button class="btn btn-primary" onclick="openBrowser()">
            <span class="btn-icon">🌐</span> اجرای نرم‌افزار (مرورگر)
        </button>

        <div class="divider"></div>

        <button class="btn btn-start" onclick="startServer()">
            <span class="btn-icon">▶️</span> راه‌اندازی سرور
        </button>

        <button class="btn btn-stop" onclick="stopServer()">
            <span class="btn-icon">⏹️</span> توقف سرور
        </button>

        <button class="btn" onclick="restartServer()">
            <span class="btn-icon">🔄</span> راه‌اندازی مجدد
        </button>

        <div class="divider"></div>

        <button class="btn" onclick="gitPull()">
            <span class="btn-icon">⬇️</span> بروزرسانی ابری (Git)
        </button>
        
        <button class="btn" onclick="npmInstall()">
            <span class="btn-icon">📦</span> نصب پیش‌نیازها (NPM)
        </button>

        <button class="btn" onclick="openFolder()">
            <span class="btn-icon">📂</span> بازکردن پوشه فایل‌ها
        </button>
    </div>

    <div class="main">
        <div class="header">
            <div class="header-titles">
                <h2>داشبورد کنترل سیستم</h2>
                <p>مانیتورینگ و مدیریت اجرای نرم‌افزار</p>
            </div>
            <div id="status-badge" class="status-badge offline">
                <span class="status-dot"></span> در حال بررسی...
            </div>
        </div>

        <div class="terminal-container">
            <div class="terminal-header">
                <span>🖥️ کنسول خروجی عملیات (Live)</span>
                <button class="clear-btn" onclick="clearTerminal()">پاک کردن صفحه</button>
            </div>
            <div id="terminal" class="terminal"></div>
        </div>
    </div>
</body>
</html>
